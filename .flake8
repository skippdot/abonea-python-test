[flake8]
jobs = auto
show-source = True
filename = *.py
# vendored third-party code is excluded from linting
exclude =
    .git,
    .venv,
    __pycache__,
    backend/wsgi/protorpc,
    *.pyc
statistics = True
max-line-length = 119
max-complexity = 10
# E401: multiple imports on one line
# E501: line length (max-line-length is enforced instead)
ignore =
    E401,
    E501
